# Third-party projects vendored in for reference. Not ours to redistribute,
# and 315 MB of someone else's git history.
_others/

# The ECLASS 14.0 ADVANCED dictionary: 1.7 GB, licensed, and referenced by no
# code in this repository. Whoever needs it downloads it from ECLASS.
ECLASS14_0_Dictionary_ADVANCED_XML_EN/

# Working copies of AAS packages, kept beside the originals while a change is
# being reviewed.
*.aasx.bak


# Reference material and generated presentations under docs/. Vendor
# datasheets and a UaExpert workspace are not ours to redistribute, and a
# deck that a script rebuilds is an artifact, not source. Markdown written
# for this repository stays.
docs/*
!docs/*.md

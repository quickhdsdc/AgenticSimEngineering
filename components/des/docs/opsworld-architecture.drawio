        <mxCell id="at" parent="a1" style="text;html=1;fontSize=30;fontStyle=1;fontColor=#0F172A;" value="Optional capability paths — C0 remains the common foundation" vertex="1">
          <mxGeometry height="50" width="1500" x="50" y="30" as="geometry" />
        </mxCell>
        <mxCell id="gradBox" parent="a1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontColor=#0F172A;fontSize=17;spacing=15;" value="&lt;font style=&quot;font-size: 23px;&quot;&gt;&lt;b&gt;C2a · Gradient path&lt;/b&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;GradientDescentSolver&lt;/b&gt;&lt;br&gt;1. evaluate(decision)&lt;br&gt;2. gradient(decision)&lt;br&gt;3. Sensitivity(PATHWISE)&lt;br&gt;4. candidate = decision − step × gradient&lt;br&gt;5. evaluate(candidate)&lt;br&gt;&lt;br&gt;&lt;b&gt;Implemented by:&lt;/b&gt;&lt;br&gt;DispatchWorld, SizingPolicyWorld" vertex="1">

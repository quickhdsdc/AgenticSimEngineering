  <diagram id="advanced-sequence" name="4 - Gradient and exact paths">
    <mxGraphModel dx="1768" dy="1061" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="900" math="0" shadow="0">

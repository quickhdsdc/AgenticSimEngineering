<mujoco model="bouncing">
  <default>
    <joint armature="0.5" damping="1" limited="false"/>
    <geom friction="0" solimp="0.99 0.99 0.01" solref="0.02 0.05"/>
  </default>

  <!-- <option integrator="RK4"/> -->
  <option gravity="0 0 -9.81" />
  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3"
     rgb2=".2 .3 .4" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="8 8" reflectance=".2"/>
  </asset>

  <worldbody>
    <geom size="0.2 0.2 .01" type="plane" material="grid" />
    <light pos="0 0 0.15"/>
    <camera name="up" pos="0 0 0.15" xyaxes="1 0 0 0 1 0"/>
    <camera name="far" pos="0 -10 5" xyaxes="1 0 0 0 1 3"/>
    <camera name="closeup" pos="0 -.1 .07" xyaxes="1 0 0 0 1 2"/>

    <geom name="wall1" size="0.001 0.1 0.02" type="box" pos="0.05 0 0"/>
    <geom name="wall2" size="0.001 0.1 0.02" type="box" pos="-0.05 0 0"/>
    <geom name="wall3" size="0.1 0.001 0.02" type="box" pos="0 -0.05 0"/>
    <geom name="wall4" size="0.1 0.001 0.02" type="box" pos="0 0.05 0"/>

    <body name="top" pos="0 0 0.01">
      <joint name="free_joint" type="free" damping="0.001" />
      <geom name="ball" type="sphere" size=".01" pos="0 0 0" density="100"  />
    </body>
  </worldbody>
  <keyframe>
    <key name="spinning" qpos="0 0 0.01 1 0 0 0" qvel="0.05 0.07 0 0 0 0" />
  </keyframe>
</mujoco>



